# Optional. Without a key, Raising Kane labels its limited sample parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Runtime interface builder: requires an API key; no mock-generation fallback.
BUILDER_MODEL=gpt-6.1-sol
# Optional Exploration API write-up; keep both private. CLI login is enough for other builder reads.
# LT_USERNAME=
# LT_ACCESS_KEY=
# Use the tested release candidate (install @testmuai/kane-cli@0.10.0-rc.3).
KANE_CLI=kane-cli
KANE_HEADLESS=1
# Optional: keep synthetic records, generated candidates and evidence outside the repo.
# RAISING_KANE_DATA_DIR=/absolute/path/to/private-data
